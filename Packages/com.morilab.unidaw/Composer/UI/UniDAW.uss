/* =====================================================================
   テーマ：Unity 標準部品の見た目をこのウィンドウ内だけ上書きする
   （このシートはウィンドウのルートに付くので、同じ詳細度ならテーマより優先される。
     個別の部品の指定は後ろに書くので、ここは先頭に置く）
   ===================================================================== */
.cd-root {
    flex-grow: 1;
    /* 同梱フォント（SIL OFL 1.1。Fonts/ の OFL-*.txt）。エディタでもゲーム内でも同じ見た目になる */
    -unity-font-definition: url("../../Fonts/BIZUDPGothic-Regular.ttf");
    background-color: rgb(22, 22, 28);
    color: rgb(214, 214, 224);
}

.unity-button {
    background-color: rgb(42, 42, 54);
    border-width: 1px;
    border-color: rgb(56, 56, 70);
    border-radius: 4px;
    color: rgb(208, 208, 222);
}
.unity-button:hover { background-color: rgb(54, 54, 68); border-color: rgb(72, 72, 90); }
.unity-button:active { background-color: rgb(32, 32, 42); }

.unity-base-text-field__input,
.unity-object-field__input,
.unity-base-popup-field__input {
    background-color: rgb(15, 15, 21);
    border-width: 1px;
    border-color: rgb(48, 48, 60);
    border-radius: 3px;
    color: rgb(224, 224, 234);
}
.unity-base-text-field__input:hover,
.unity-object-field__input:hover { border-color: rgb(70, 70, 88); }
.unity-base-text-field__input:focus { border-color: rgb(100, 140, 230); }

.cd-small { flex-direction: row; align-items: center; margin-left: 4px; margin-right: 2px; }
.cd-small > Label { min-width: 0; padding-right: 2px; font-size: 11px; }

/* =====================================================================
   トランスポートバー
   ===================================================================== */
.cd-tbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    flex-wrap: wrap;
    min-height: 48px;
    padding: 4px 8px;
    background-color: rgb(32, 32, 41);
    border-bottom-width: 1px;
    border-color: rgb(12, 12, 16);
}
.cd-tb-group { flex-direction: row; align-items: center; margin: 2px 2px; }
.cd-tb-sep { width: 1px; height: 30px; margin: 0 4px; background-color: rgb(56, 56, 70); }
.cd-tb-spacer { flex-grow: 1; }

/* アイコンボタン */
.cd-ibtn {
    width: 40px;
    height: 36px;
    margin: 0 2px;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(58, 58, 74);
    background-color: rgb(44, 44, 57);
    color: rgb(196, 196, 212);
}
.cd-ibtn:hover { background-color: rgb(58, 58, 74); color: rgb(240, 240, 250); }
.cd-ibtn:active { background-color: rgb(30, 30, 40); }
.cd-ibtn-icon { width: 14px; height: 14px; margin-bottom: 3px; }
.cd-ibtn-cap {
    margin: 0;
    padding: 0;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(140, 140, 158);
}
.cd-ibtn.play { color: rgb(120, 220, 150); }
.cd-ibtn.play.on {
    background-color: rgb(36, 92, 58);
    border-color: rgb(96, 224, 140);
    color: rgb(170, 255, 196);
}
.cd-ibtn.play.on > .cd-ibtn-cap { color: rgb(170, 255, 196); }
.cd-ibtn.rec { color: rgb(232, 88, 88); }
.cd-ibtn.rec.on {
    background-color: rgb(112, 28, 34);
    border-color: rgb(255, 90, 90);
    color: rgb(255, 150, 150);
}
.cd-ibtn.rec.on > .cd-ibtn-cap { color: rgb(255, 170, 170); }
.cd-ibtn.loop { color: rgb(130, 170, 255); }
.cd-ibtn.loop.on {
    background-color: rgb(34, 54, 104);
    border-color: rgb(110, 150, 255);
    color: rgb(190, 210, 255);
}
.cd-ibtn.loop.on > .cd-ibtn-cap { color: rgb(190, 210, 255); }
.cd-ibtn.flat {
    width: 30px;
    height: 30px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.cd-ibtn.flat:hover { background-color: rgb(48, 48, 62); }
.cd-ibtn.flat > .cd-ibtn-icon { margin-bottom: 0; }

/* 液晶風の位置表示 */
.cd-lcd {
    flex-direction: row;
    align-items: center;
    height: 36px;
    margin: 2px 8px;
    padding: 0 8px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(36, 54, 44);
    background-color: rgb(9, 14, 11);
}
.cd-lcd-state {
    width: 40px;
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(70, 104, 82);
}
.cd-lcd.playing > .cd-lcd-state { color: rgb(120, 255, 160); }
.cd-lcd-field { align-items: center; margin-left: 7px; }
.cd-lcd-cap { margin: 0; padding: 0; font-size: 9px; color: rgb(64, 100, 78); }
.cd-lcd-val {
    margin: 0;
    padding: 0;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(96, 150, 114);
}
.cd-lcd.playing .cd-lcd-val { color: rgb(150, 255, 184); }

/* 数値ボックス */
.cd-nbox {
    min-width: 40px;
    height: 36px;
    margin: 0 2px;
    padding: 0 5px;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(48, 48, 62);
    background-color: rgb(17, 17, 24);
    cursor: resize-vertical;
}
.cd-nbox.wide { min-width: 58px; }
.cd-nbox:hover { border-color: rgb(80, 80, 104); }
.cd-nbox.dragging { border-color: rgb(110, 150, 240); }
.cd-nbox-cap { margin: 0; padding: 0; font-size: 9px; -unity-font-style: bold; color: rgb(120, 120, 140); }
.cd-nbox-val { margin: 0; padding: 0; font-size: 15px; -unity-font-style: bold; color: rgb(140, 190, 255); }
.cd-nbox-edit { position: absolute; left: 2px; right: 2px; bottom: 3px; margin: 0; }
.cd-nbox-edit > .unity-base-text-field__input { -unity-text-align: middle-center; font-size: 13px; }

/* 表示切替 */
.cd-seg {
    flex-direction: row;
    height: 28px;
    margin: 0 4px;
    padding: 2px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(48, 48, 62);
    background-color: rgb(17, 17, 24);
}
.cd-seg-item {
    padding: 0 8px;
    border-radius: 3px;
    font-size: 11px;
    -unity-text-align: middle-center;
    color: rgb(140, 140, 158);
}
.cd-seg-item:hover { color: rgb(230, 230, 240); background-color: rgb(36, 36, 48); }
.cd-seg-item.on { background-color: rgb(62, 86, 150); color: rgb(255, 255, 255); }

/* 札 */
.cd-tchip {
    height: 24px;
    margin: 0 4px;
    padding: 0 8px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgb(56, 56, 70);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(130, 130, 150);
    background-color: rgb(28, 28, 37);
    font-size: 11px;
}
.cd-tchip:hover { color: rgb(220, 220, 235); }
.cd-tchip.on { background-color: rgb(46, 64, 108); border-color: rgb(90, 124, 210); color: rgb(190, 212, 255); }

.cd-mchip {
    flex-direction: row;
    align-items: center;
    height: 28px;
    margin: 0 4px;
    padding: 0 6px 0 10px;
    border-radius: 5px;
    border-width: 1px;
    border-color: rgb(56, 56, 70);
    background-color: rgb(40, 40, 52);
}
.cd-mchip:hover { background-color: rgb(52, 52, 66); }
.cd-mchip-text { margin: 0; padding: 0; overflow: hidden; text-overflow: ellipsis; -unity-font-style: bold; color: rgb(226, 226, 236); }
.cd-mchip-arrow { margin: 0 0 0 6px; padding: 0; font-size: 10px; color: rgb(130, 130, 150); }
.cd-mchip.empty > .cd-mchip-text { color: rgb(255, 200, 110); }
.cd-songchip { width: 150px; justify-content: space-between; }
.cd-songchip > .cd-mchip-text { flex-shrink: 1; }
.cd-midichip { max-width: 160px; }
.cd-midichip > .cd-mchip-text { font-size: 10px; color: rgb(140, 140, 158); }
.cd-midichip.on > .cd-mchip-text { color: rgb(150, 220, 255); }

/* レベルメーター */
.cd-meter { flex-direction: row; align-items: flex-end; height: 30px; margin: 0 6px; }
.cd-meter-track {
    width: 6px;
    height: 100%;
    margin: 0 1px;
    border-radius: 2px;
    justify-content: flex-end;
    overflow: hidden;
    background-color: rgb(15, 15, 21);
}
.cd-meter-fill { height: 0; border-radius: 2px; }
.cd-meter-fill.c0 { background-color: rgb(255, 110, 110); }
.cd-meter-fill.c1 { background-color: rgb(255, 196, 92); }
.cd-meter-fill.c2 { background-color: rgb(110, 214, 255); }
.cd-meter-fill.c3 { background-color: rgb(196, 152, 255); }


.cd-banner {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgb(90, 60, 20);
    flex-shrink: 0;
}
.cd-banner > Label { flex-grow: 1; white-space: normal; }

.cd-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.cd-left {
    width: 150px;
    flex-shrink: 0;
    padding: 4px;
    border-right-width: 1px;
    border-color: rgb(50, 50, 60);
}
.cd-center { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.cd-right {
    width: 270px;
    flex-shrink: 0;
    padding: 4px;
    border-left-width: 1px;
    border-color: rgb(50, 50, 60);
}
.cd-right-summary {
    padding: 3px 6px;
    margin-bottom: 4px;
    background-color: rgb(24, 24, 31);
    border-radius: 3px;
    color: rgb(255, 210, 90);
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.cd-right-tabs { margin-bottom: 4px; }
.cd-right-page { flex-grow: 1; min-height: 0; }
.cd-right Label { min-width: 0; }
.cd-right .unity-base-field__label { min-width: 90px; width: 90px; }

.cd-panel-title {
    -unity-font-style: bold;
    color: rgb(150, 200, 255);
    margin-top: 6px;
    margin-bottom: 2px;
}
.cd-btnrow { flex-direction: row; flex-wrap: wrap; }
.cd-btnrow > Button { flex-grow: 1; margin: 1px; }
.cd-condrow { flex-direction: row; }
.cd-condrow > .cd-cond-a { flex-grow: 1; }
.cd-condrow > IntegerField { width: 50px; }
.cd-help { white-space: normal; font-size: 10px; color: rgb(140, 140, 155); margin-top: 6px; }

.cd-patitem {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    margin-bottom: 1px;
    background-color: rgb(34, 34, 42);
    border-left-width: 3px;
    border-color: rgb(34, 34, 42);
}
.cd-patitem:hover { background-color: rgb(42, 42, 54); }
.cd-patitem.selected { background-color: rgb(50, 70, 110); border-color: rgb(255, 210, 90); }
.cd-patitem.drag { opacity: 0.6; }
.cd-patitem-name { flex-grow: 1; flex-shrink: 1; font-size: 11px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cd-patitem-meta { flex-shrink: 0; font-size: 10px; color: rgb(150, 150, 170); }
.cd-patitem.unused .cd-patitem-name { color: rgb(140, 140, 150); }

.cd-patbar {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    flex-shrink: 0;
    background-color: rgb(32, 32, 40);
}
.cd-edhead {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 2px 4px;
    flex-shrink: 0;
    background-color: rgb(32, 32, 40);
    border-bottom-width: 1px;
    border-color: rgb(50, 50, 62);
}
.cd-edhead-group { flex-direction: row; align-items: center; margin-right: 8px; }
.cd-roll-headtools { flex-direction: row; align-items: center; }
/* ピアノロールのチャンネル切替（波形アイコン＋名前。選ぶとチャンネルの色） */
.cd-roll-chs { flex-direction: row; align-items: center; margin: 2px 6px 2px 0; }
.cd-ibtn.cd-roll-ch { width: 58px; height: 34px; margin: 0 3px 0 0; }
.cd-ibtn.cd-roll-ch > .cd-ibtn-icon { width: 22px; height: 11px; margin-bottom: 4px; }
.cd-ibtn.cd-roll-ch.ch0 { color: rgb(110, 175, 225); }
.cd-ibtn.cd-roll-ch.ch1 { color: rgb(120, 205, 140); }
.cd-ibtn.cd-roll-ch.ch2 { color: rgb(225, 170, 100); }
.cd-ibtn.cd-roll-ch.ch3 { color: rgb(205, 135, 205); }
.cd-ibtn.cd-roll-ch.on > .cd-ibtn-cap { color: rgb(240, 240, 250); }
.cd-ibtn.cd-roll-ch.ch0.on { background-color: rgb(30, 64, 92); border-color: rgb(90, 190, 255); color: rgb(150, 215, 255); }
.cd-ibtn.cd-roll-ch.ch1.on { background-color: rgb(32, 80, 44); border-color: rgb(115, 240, 140); color: rgb(160, 250, 180); }
.cd-ibtn.cd-roll-ch.ch2.on { background-color: rgb(92, 60, 24); border-color: rgb(255, 180, 80); color: rgb(255, 205, 140); }
.cd-ibtn.cd-roll-ch.ch3.on { background-color: rgb(78, 36, 80); border-color: rgb(230, 130, 230); color: rgb(245, 185, 245); }
.cd-lcd-link:hover { background-color: rgba(120, 160, 255, 0.15); }
.cd-songpanel { margin-top: 6px; }
.cd-songpanel-cap { width: 90px; min-width: 90px; padding-left: 3px; }
.cd-patlabel { -unity-font-style: bold; margin: 0 6px; font-size: 13px; }
.cd-patnav { width: 28px; height: 24px; padding: 0; font-size: 13px; }
.cd-edhead-group > Button { height: 24px; padding: 0 8px; }
.cd-patname { width: 140px; }

.cd-main { flex-grow: 1; min-height: 0; }
.cd-main:focus { border-color: rgb(80, 110, 170); }

/* ---------------- Tracker ---------------- */
.cd-tracker { flex-grow: 1; min-height: 0; }
.cd-tscroll { flex-grow: 1; }
.cd-trow { flex-direction: row; height: 16px; flex-shrink: 0; }
.cd-trow.beat { background-color: rgb(30, 30, 38); }
.cd-trow.bar { background-color: rgb(38, 38, 50); }
.cd-trow.cursor-row { background-color: rgb(40, 50, 70); }
.cd-trow.playing { background-color: rgb(40, 85, 55); }
.cd-thead { height: 22px; background-color: rgb(36, 36, 46); }

.cd-cell {
    font-size: 12px;
    /* トラッカーの数字・音名は等幅で桁をそろえる */
    -unity-font-definition: url("../../Fonts/JetBrainsMono-Regular.ttf");
    padding: 0 1px;
    margin: 0;
    -unity-text-align: middle-center;
    color: rgb(220, 220, 230);
}
.cd-cell.empty { color: rgb(80, 80, 92); }
.cd-cell.ghost { opacity: 0.45; }
.cd-cell.cursor { background-color: rgb(90, 120, 200); color: rgb(255, 255, 255); }
.cd-num { width: 30px; color: rgb(120, 120, 140); }
.cd-note { width: 32px; color: rgb(240, 240, 250); }
.cd-inst { width: 22px; color: rgb(130, 200, 255); }
.cd-vol { width: 14px; color: rgb(140, 255, 160); }
.cd-fxt { width: 12px; color: rgb(255, 170, 110); }
.cd-fxp { width: 20px; color: rgb(255, 210, 150); }
.cd-flag { width: 12px; color: rgb(255, 120, 220); }
.cd-tgroup {
    flex-direction: row;
    border-left-width: 1px;
    border-color: rgb(60, 60, 72);
    padding-left: 2px;
    padding-right: 2px;
}
.cd-chhead-t {
    flex-direction: row;
    align-items: center;
    width: 166px;
    border-left-width: 1px;
    border-color: rgb(60, 60, 72);
    padding-left: 4px;
}
.cd-chname { -unity-font-style: bold; flex-grow: 1; }
.ch0 .cd-chname { color: rgb(255, 120, 120); }
.ch1 .cd-chname { color: rgb(255, 200, 100); }
.ch2 .cd-chname { color: rgb(120, 220, 255); }
.ch3 .cd-chname { color: rgb(200, 160, 255); }
.cd-ms { width: 24px; height: 20px; margin: 1px; padding: 0; font-size: 11px; -unity-font-style: bold; }
.cd-ms.on { background-color: rgb(200, 150, 40); color: rgb(20, 20, 20); }

/* ---------------- Step ---------------- */
.cd-stepview { flex-grow: 1; min-height: 0; }
.cd-chblock { padding: 4px; margin-bottom: 4px; background-color: rgb(30, 30, 38); }
.cd-chhead { flex-direction: row; align-items: center; height: 22px; }
.cd-len { width: 90px; }
.cd-len > Label { min-width: 0; width: 28px; }
.cd-chinfo { color: rgb(140, 140, 155); font-size: 11px; margin-left: 6px; }
.cd-steps { flex-direction: row; flex-wrap: wrap; }
.cd-step {
    width: 36px;
    height: 36px;
    margin: 1px;
    border-radius: 3px;
    background-color: rgb(46, 46, 56);
    justify-content: flex-end;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}
.cd-step.beat { background-color: rgb(56, 56, 70); }
.cd-step.ghost { opacity: 0.35; }
.cd-step-vol { position: absolute; left: 0; right: 0; bottom: 0; height: 0; }
.ch0 .cd-step.on .cd-step-vol { background-color: rgba(255, 110, 110, 0.75); }
.ch1 .cd-step.on .cd-step-vol { background-color: rgba(255, 190, 90, 0.75); }
.ch2 .cd-step.on .cd-step-vol { background-color: rgba(110, 210, 255, 0.75); }
.ch3 .cd-step.on .cd-step-vol { background-color: rgba(190, 150, 255, 0.75); }
.cd-step.off { background-color: rgb(70, 40, 40); }
.cd-step.fxonly { border-color: rgb(255, 170, 110); }
.cd-step.prob { border-color: rgb(255, 120, 220); }
.cd-step.cursor { border-color: rgb(255, 255, 255); border-width: 2px; }
.cd-step.playing { background-color: rgb(70, 140, 90); }
.cd-step-note { font-size: 9px; -unity-text-align: lower-center; color: rgb(255, 255, 255); }
.cd-step-lock {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: rgb(255, 230, 120);
}

.cd-status {
    flex-shrink: 0;
    flex-direction: row;
    padding: 2px 6px;
    font-size: 11px;
    background-color: rgb(20, 20, 26);
    color: rgb(160, 160, 175);
    border-top-width: 1px;
    border-color: rgb(50, 50, 60);
}
.cd-status-msg { flex-shrink: 1; min-width: 0; color: rgb(140, 220, 160); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 12px; }
.cd-status-msg.error { color: rgb(240, 130, 110); }
.cd-status-hint { flex-grow: 1; flex-shrink: 1; min-width: 0; -unity-text-align: middle-right; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cd-tb-help { min-width: 22px; margin-left: 4px; -unity-font-style: bold; }

.cd-keyhelp {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
    padding: 24px;
}
.cd-keyhelp-card {
    max-width: 960px;
    max-height: 100%;
    padding: 8px 10px;
    background-color: rgb(32, 32, 41);
    border-width: 1px;
    border-color: rgb(70, 70, 88);
    border-radius: 4px;
}
.cd-keyhelp-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.cd-keyhelp-search { width: 220px; margin: 0 8px; }
.cd-keyhelp-preset { font-size: 11px; color: rgb(140, 140, 158); }
.cd-keyhelp-cols { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.cd-keyhelp-sec {
    width: 300px;
    margin: 0 8px 8px 0;
    padding: 6px 8px;
    background-color: rgb(24, 24, 31);
    border-width: 1px;
    border-color: rgb(24, 24, 31);
    border-radius: 4px;
}
.cd-keyhelp-sec.current { border-color: rgb(90, 124, 210); background-color: rgb(26, 30, 44); }
.cd-keyhelp-title { font-size: 12px; -unity-font-style: bold; color: rgb(220, 220, 235); margin-bottom: 4px; }
.cd-keyhelp-sec.current > .cd-keyhelp-title { color: rgb(170, 200, 255); }
.cd-keyhelp-row { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.cd-keyhelp-key {
    width: 116px;
    flex-shrink: 0;
    margin: 0 8px 0 0;
    padding: 1px 5px;
    border-radius: 3px;
    background-color: rgb(44, 44, 57);
    color: rgb(255, 210, 120);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: normal;
}
.cd-keyhelp-desc { flex-grow: 1; flex-shrink: 1; font-size: 12px; color: rgb(200, 200, 214); white-space: normal; padding: 1px 0; }
.cd-keyhelp-empty { color: rgb(140, 140, 158); margin: 8px; }

.cd-start { flex-grow: 1; align-items: center; justify-content: center; padding: 16px; }
.cd-start-card { max-width: 560px; padding: 16px 20px; background-color: rgb(30, 30, 39); border-radius: 6px; }
.cd-start-title { font-size: 22px; -unity-font-style: bold; color: rgb(255, 210, 90); margin-bottom: 4px; }
.cd-start-sub { white-space: normal; color: rgb(150, 150, 165); margin-bottom: 8px; }
.cd-start-cap { -unity-font-style: bold; margin-top: 10px; margin-bottom: 4px; }
.cd-start-song { -unity-text-align: middle-left; margin: 0 0 2px 0; }

/* ピアノロール */
.cd-roll-tools { height: 26px; margin: 0 6px; padding: 2px; }
.cd-roll-tools > .cd-seg-item { padding: 0 10px; font-size: 11px; }
.cd-roll-canvas.resize { cursor: resize-horizontal; }
.cd-lane { flex-shrink: 0; border-top-width: 1px; border-color: rgb(60, 60, 72); }
.cd-lane-fx { width: 150px; margin: 0 4px; font-size: 10px; }
.cd-roll-marquee {
    border-width: 1px;
    border-color: rgb(150, 190, 255);
    background-color: rgba(120, 160, 255, 0.15);
}

/* =====================================================================
   下ゾーン（ミキサー / 楽器エディタ）
   ===================================================================== */
.cd-splitter { flex-shrink: 0; background-color: rgb(44, 44, 56); }
.cd-splitter:hover, .cd-splitter.drag { background-color: rgb(80, 110, 170); }
.cd-splitter-v { width: 4px; cursor: resize-horizontal; }
.cd-splitter-h { height: 4px; cursor: resize-vertical; }
.cd-lower { flex-grow: 0; flex-shrink: 0; min-height: 0; background-color: rgb(26, 26, 33); border-top-width: 1px; border-color: rgb(50, 50, 62); }
.cd-lower-bar { flex-direction: row; align-items: center; padding: 2px 4px; flex-shrink: 0; background-color: rgb(32, 32, 40); }
.cd-lower-close { width: 26px; height: 22px; padding: 0; margin: 0; font-size: 12px; }

.cd-mixer { flex-direction: row; flex-grow: 1; min-height: 0; padding: 4px; }
.cd-strip {
    width: 92px;
    margin-right: 4px;
    padding: 3px;
    align-items: stretch;
    border-radius: 4px;
    background-color: rgb(34, 34, 43);
}
.cd-strip.master { width: 96px; margin-left: 8px; background-color: rgb(38, 36, 30); }
.cd-strip.silenced { opacity: 0.55; }
.cd-strip-name { flex-grow: 0; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 11px; margin-bottom: 2px; }
.cd-strip .cd-btnrow { justify-content: center; flex-wrap: nowrap; }
.cd-strip .cd-ms { flex-grow: 1; height: 22px; }
.cd-strip-pan, .cd-strip-db { -unity-text-align: middle-center; font-size: 10px; color: rgb(170, 170, 186); }
.cd-strip-faderrow { flex-direction: row; flex-grow: 1; min-height: 40px; justify-content: center; margin-top: 2px; }
.cd-strip-meter { height: auto; flex-grow: 0; margin: 4px 2px; }
.cd-strip-clear { height: 20px; margin: 1px 0; padding: 0; font-size: 11px; }
.cd-meter-fill.cm { background-color: rgb(120, 230, 140); }

.cd-fader.vertical { width: 22px; flex-grow: 0; flex-shrink: 0; margin: 4px 2px; }
.cd-fader.horizontal { height: 14px; flex-shrink: 0; margin: 2px 0; }

.cd-insted { flex-direction: row; flex-grow: 1; min-height: 0; padding: 4px; }
.cd-insted-left { width: 170px; flex-shrink: 0; margin-right: 6px; }
.cd-insted-left > .cd-roll-tools { margin: 0 0 3px 0; }
.cd-insted-list { flex-grow: 1; background-color: rgb(18, 18, 24); border-radius: 3px; }
.cd-insted-item { padding: 1px 6px; font-size: 11px; }
.cd-insted-item:hover { background-color: rgb(40, 40, 52); }
.cd-insted-item.on { background-color: rgb(50, 70, 110); color: rgb(255, 255, 255); }
.cd-insted-right { flex-grow: 1; min-width: 0; }
.cd-insted-head { flex-direction: row; align-items: center; flex-shrink: 0; }
.cd-insted-name { width: 140px; margin-right: 6px; }
.cd-macro-graph { flex-grow: 1; min-height: 60px; margin: 4px 0; border-radius: 3px; overflow: hidden; }
.cd-macro-hover { position: absolute; left: 4px; top: 2px; font-size: 10px; color: rgb(200, 200, 215); }
.cd-insted-foot { flex-direction: row; align-items: flex-start; flex-shrink: 0; }
.cd-insted-seq { flex-grow: 1; margin: 0 6px 0 0; }
.cd-insted-info { width: 260px; flex-shrink: 0; white-space: normal; font-size: 10px; color: rgb(150, 150, 165); }

/* ---- 入力支援（下ゾーン） */
.cd-assist { flex-direction: column; }
.cd-assist-sec { min-width: 0; margin-bottom: 6px; padding: 4px 6px; background-color: rgb(30, 30, 39); border-radius: 3px; }
.cd-assist-row { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 4px; }
.cd-assist-row > * { margin-right: 4px; margin-bottom: 2px; }
.cd-assist-chords { margin: 0 0 4px 0; }
.cd-assist-info { white-space: normal; font-size: 10px; color: rgb(150, 150, 165); margin-top: 4px; }
.cd-assist-info.error { color: rgb(240, 130, 110); }
.cd-assist-prompt { margin: 0 0 4px 0; min-height: 40px; }
.cd-assist-prompt TextInput, .cd-assist-prompt .unity-text-field__input { white-space: normal; }
.cd-assist-key { flex-grow: 1; min-width: 120px; margin: 0; }
.cd-assist-bars { width: 70px; margin: 0; }
.cd-assist-next { white-space: normal; }

/* ---- センドエフェクト（ミキサー） */
.cd-send { flex-direction: row; align-items: center; flex-shrink: 0; height: 16px; }
.cd-send-cap { width: 24px; flex-shrink: 0; font-size: 9px; padding: 0; margin: 0; color: rgb(150, 150, 168); }
.cd-send > .cd-fader.horizontal { flex-grow: 1; height: 10px; margin: 0; }
.cd-send-val { width: 38px; flex-shrink: 0; font-size: 10px; padding: 0 0 0 2px; -unity-text-align: middle-right; color: rgb(170, 170, 186); }
.cd-send.narrow > .cd-send-val { width: 26px; }
.cd-fxstrip { width: 160px; background-color: rgb(30, 36, 42); }
.cd-fx-caption { font-size: 10px; -unity-font-style: bold; color: rgb(140, 200, 230); margin: 4px 0 1px 0; }
.cd-fxstrip .cd-btnrow { justify-content: flex-start; }

/* ---- マスタリング（下ゾーン） */
.cd-master-chain { width: 220px; flex-shrink: 0; background-color: rgb(38, 36, 30); }
.cd-master.off .cd-master-chain .cd-send { opacity: 0.5; }
.cd-master-gr { font-size: 10px; color: rgb(230, 190, 120); margin-top: 4px; -unity-text-align: middle-right; }
.cd-master-analysis { flex-grow: 1; min-width: 0; padding: 3px 6px; border-radius: 4px; background-color: rgb(30, 30, 39); }
.cd-master-analysis .cd-btnrow { justify-content: flex-start; }
.cd-master-analysis .cd-btnrow > Button { height: 22px; padding: 0 8px; font-size: 11px; }
.cd-master-status { font-size: 10px; color: rgb(140, 200, 230); margin: 3px 0; }
.cd-loud-row { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 2px 0; }
.cd-loud-text { font-size: 11px; color: rgb(140, 210, 250); margin-right: 8px; }
.cd-loud-ab { font-size: 10px; color: rgb(230, 190, 120); margin-left: 4px; }
.cd-loud-graph { height: 56px; margin: 2px 0 4px 0; border-radius: 3px; }
.cd-master-report { white-space: normal; font-size: 11px; color: rgb(200, 204, 214); margin-top: 4px; }

/* ---- アレンジ（下ゾーン） */
.cd-arrange { flex-grow: 0; flex-shrink: 0; min-height: 0; padding: 2px 4px; background-color: rgb(28, 28, 36); }
.cd-arrange-bar { flex-direction: row; align-items: center; flex-shrink: 0; margin-bottom: 2px; }
.cd-arrange-name { font-size: 10px; -unity-font-style: bold; color: rgb(170, 170, 190); margin-right: 6px; }
.cd-arrange-btn { height: 22px; padding: 0 8px; margin: 0 3px 0 0; font-size: 11px; }
.cd-arrange-info { margin-left: 8px; font-size: 10px; color: rgb(150, 150, 165); }
.cd-arrange-scroll { flex-grow: 1; min-height: 0; background-color: rgb(20, 20, 26); border-radius: 3px; }
.cd-arrange-canvas { height: 80px; flex-shrink: 0; }
.cd-arrange-ruler { position: absolute; left: 0; right: 0; top: 0; height: 18px; border-bottom-width: 1px; border-color: rgb(50, 50, 62); }
.cd-arrange-block { position: absolute; bottom: 2px; border-radius: 3px; border-width: 1px; border-color: rgba(255, 255, 255, 0.12); overflow: hidden; }
.cd-arrange-block:hover { border-color: rgba(255, 255, 255, 0.4); }
.cd-arrange-block.sel { border-color: rgb(255, 210, 90); border-width: 2px; }
.cd-arrange-block.drag { opacity: 0.7; }
.cd-arrange-title { position: absolute; left: 3px; top: 0; font-size: 10px; color: rgb(235, 235, 245); padding: 0; margin: 0; white-space: nowrap; }
.cd-arrange-playhead { position: absolute; top: 0; bottom: 0; width: 1px; background-color: rgb(255, 120, 90); }
.cd-arrange-drop { position: absolute; top: 18px; bottom: 0; width: 2px; background-color: rgb(255, 210, 90); }

.cd-assist-cand { min-width: 34px; }

.cd-tooltip {
    position: absolute; max-width: 360px; padding: 4px 7px;
    background-color: rgb(28, 30, 36); border-width: 1px; border-color: rgb(78, 84, 100); border-radius: 3px;
}
.cd-tooltip > Label { white-space: normal; color: rgb(220, 224, 232); font-size: 11px; }
.cd-assist-cand.on { background-color: rgb(62, 86, 150); border-color: rgb(90, 124, 210); color: rgb(255, 255, 255); }

/* 名前を聞く画面（ゲーム内の書き出し等） */
.cd-prompt-card { width: 420px; max-width: 100%; }
.cd-prompt-label { font-size: 11px; color: rgb(150, 150, 168); margin: 6px 0 4px 0; white-space: normal; }
.cd-prompt-field { margin: 0 0 8px 0; }
.cd-prompt-buttons { flex-direction: row; justify-content: flex-end; }
.cd-prompt-ok { background-color: rgb(60, 90, 170); border-color: rgb(80, 112, 200); min-width: 64px; }

/* タッチの右クリックモード（ゲーム内） */
.cd-touch-right { position: absolute; right: 8px; bottom: 32px; width: 44px; height: 44px; border-radius: 22px; font-size: 18px; opacity: 0.8; }
.cd-touch-right--on { background-color: rgb(190, 110, 40); border-color: rgb(230, 150, 70); opacity: 1; }
