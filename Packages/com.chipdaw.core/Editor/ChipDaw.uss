.cd-root {
    flex-grow: 1;
    background-color: rgb(24, 24, 30);
    color: rgb(210, 210, 220);
}

.cd-toolbar { flex-shrink: 0; }
.cd-songfield { width: 180px; }
.cd-small { flex-direction: row; align-items: center; margin-left: 4px; margin-right: 2px; }
.cd-small > Label { min-width: 0; padding-right: 2px; font-size: 11px; }
.cd-rec:checked { color: rgb(255, 90, 90); }

.cd-banner {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgb(90, 60, 20);
    flex-shrink: 0;
}
.cd-banner > Label { flex-grow: 1; white-space: normal; }

.cd-body { flex-direction: row; flex-grow: 1; min-height: 0; }
.cd-left {
    width: 150px;
    flex-shrink: 0;
    padding: 4px;
    border-right-width: 1px;
    border-color: rgb(50, 50, 60);
}
.cd-center { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.cd-right {
    width: 270px;
    flex-shrink: 0;
    padding: 4px;
    border-left-width: 1px;
    border-color: rgb(50, 50, 60);
}
.cd-right Label { min-width: 0; }
.cd-right .unity-base-field__label { min-width: 90px; width: 90px; }

.cd-panel-title {
    -unity-font-style: bold;
    color: rgb(150, 200, 255);
    margin-top: 6px;
    margin-bottom: 2px;
}
.cd-btnrow { flex-direction: row; flex-wrap: wrap; }
.cd-btnrow > Button { flex-grow: 1; margin: 1px; }
.cd-condrow { flex-direction: row; }
.cd-condrow > .cd-cond-a { flex-grow: 1; }
.cd-condrow > IntegerField { width: 50px; }
.cd-help { white-space: normal; font-size: 10px; color: rgb(140, 140, 155); margin-top: 6px; }

.cd-order-item {
    -unity-text-align: middle-left;
    margin: 0;
    border-radius: 0;
    background-color: rgb(34, 34, 42);
    font-size: 11px;
}
.cd-order-item.selected { background-color: rgb(50, 70, 110); }
.cd-order-item.playing { color: rgb(120, 255, 140); }

.cd-patbar {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    flex-shrink: 0;
    background-color: rgb(32, 32, 40);
}
.cd-patlabel { -unity-font-style: bold; margin: 0 6px; }
.cd-patname { width: 140px; }

.cd-main { flex-grow: 1; min-height: 0; }
.cd-main:focus { border-color: rgb(80, 110, 170); }

/* ---------------- Tracker ---------------- */
.cd-tracker { flex-grow: 1; min-height: 0; }
.cd-tscroll { flex-grow: 1; }
.cd-trow { flex-direction: row; height: 16px; flex-shrink: 0; }
.cd-trow.beat { background-color: rgb(30, 30, 38); }
.cd-trow.bar { background-color: rgb(38, 38, 50); }
.cd-trow.cursor-row { background-color: rgb(40, 50, 70); }
.cd-trow.playing { background-color: rgb(40, 85, 55); }
.cd-thead { height: 22px; background-color: rgb(36, 36, 46); }

.cd-cell {
    font-size: 12px;
    padding: 0 1px;
    margin: 0;
    -unity-text-align: middle-center;
    color: rgb(220, 220, 230);
}
.cd-cell.empty { color: rgb(80, 80, 92); }
.cd-cell.ghost { opacity: 0.45; }
.cd-cell.cursor { background-color: rgb(90, 120, 200); color: rgb(255, 255, 255); }
.cd-num { width: 30px; color: rgb(120, 120, 140); }
.cd-note { width: 32px; color: rgb(240, 240, 250); }
.cd-inst { width: 22px; color: rgb(130, 200, 255); }
.cd-vol { width: 14px; color: rgb(140, 255, 160); }
.cd-fxt { width: 12px; color: rgb(255, 170, 110); }
.cd-fxp { width: 20px; color: rgb(255, 210, 150); }
.cd-flag { width: 12px; color: rgb(255, 120, 220); }
.cd-tgroup {
    flex-direction: row;
    border-left-width: 1px;
    border-color: rgb(60, 60, 72);
    padding-left: 2px;
    padding-right: 2px;
}
.cd-chhead-t {
    flex-direction: row;
    align-items: center;
    width: 166px;
    border-left-width: 1px;
    border-color: rgb(60, 60, 72);
    padding-left: 4px;
}
.cd-chname { -unity-font-style: bold; flex-grow: 1; }
.ch0 .cd-chname { color: rgb(255, 120, 120); }
.ch1 .cd-chname { color: rgb(255, 200, 100); }
.ch2 .cd-chname { color: rgb(120, 220, 255); }
.ch3 .cd-chname { color: rgb(200, 160, 255); }
.cd-ms { width: 20px; height: 16px; margin: 1px; padding: 0; font-size: 10px; }
.cd-ms.on { background-color: rgb(200, 150, 40); color: rgb(20, 20, 20); }

/* ---------------- Step ---------------- */
.cd-stepview { flex-grow: 1; min-height: 0; }
.cd-chblock { padding: 4px; margin-bottom: 4px; background-color: rgb(30, 30, 38); }
.cd-chhead { flex-direction: row; align-items: center; height: 22px; }
.cd-len { width: 90px; }
.cd-len > Label { min-width: 0; width: 28px; }
.cd-chinfo { color: rgb(140, 140, 155); font-size: 11px; margin-left: 6px; }
.cd-steps { flex-direction: row; flex-wrap: wrap; }
.cd-step {
    width: 36px;
    height: 36px;
    margin: 1px;
    border-radius: 3px;
    background-color: rgb(46, 46, 56);
    justify-content: flex-end;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    overflow: hidden;
}
.cd-step.beat { background-color: rgb(56, 56, 70); }
.cd-step.ghost { opacity: 0.35; }
.cd-step-vol { position: absolute; left: 0; right: 0; bottom: 0; height: 0; }
.ch0 .cd-step.on .cd-step-vol { background-color: rgba(255, 110, 110, 0.75); }
.ch1 .cd-step.on .cd-step-vol { background-color: rgba(255, 190, 90, 0.75); }
.ch2 .cd-step.on .cd-step-vol { background-color: rgba(110, 210, 255, 0.75); }
.ch3 .cd-step.on .cd-step-vol { background-color: rgba(190, 150, 255, 0.75); }
.cd-step.off { background-color: rgb(70, 40, 40); }
.cd-step.fxonly { border-color: rgb(255, 170, 110); }
.cd-step.prob { border-color: rgb(255, 120, 220); }
.cd-step.cursor { border-color: rgb(255, 255, 255); border-width: 2px; }
.cd-step.playing { background-color: rgb(70, 140, 90); }
.cd-step-note { font-size: 9px; -unity-text-align: lower-center; color: rgb(255, 255, 255); }
.cd-step-lock {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 5px;
    height: 5px;
    border-radius: 3px;
    background-color: rgb(255, 230, 120);
}

.cd-status {
    flex-shrink: 0;
    padding: 2px 6px;
    font-size: 11px;
    background-color: rgb(20, 20, 26);
    color: rgb(160, 160, 175);
    border-top-width: 1px;
    border-color: rgb(50, 50, 60);
}
